# Copy thành file .env (không đưa .env lên mạng).
#
# CHẠY LOCAL trên máy mình (`npm run dev`): web dùng database D1 LOCAL
# (miniflare) — next.config.mjs tự nạp binding DB từ wrangler.toml, dữ
# liệu lưu ở .wrangler/state. Nạp bảng + dữ liệu mẫu lần đầu bằng:
#   npx wrangler d1 execute fashion-store --local --file=../fashion-store-d1-create.sql
#   npx wrangler d1 execute fashion-store --local --file=../fashion-store-d1-insert.sql
# (file SQL nằm ngoài thư mục code, ở cùng chỗ với file zip.)
# Web lúc chạy KHÔNG đọc DATABASE_URL nữa (xem src/lib/prisma.ts).
#
# DATABASE_URL dưới đây CHỈ dùng cho lệnh Prisma CLI với file SQLite local
# (vd: npx prisma db push, npx prisma generate, node prisma/seed.cjs) —
# đường dẫn tính từ thư mục prisma/, nên ghi dạng
# file:../database/sqlite/fashion-store.db.
DATABASE_URL="file:../database/sqlite/fashion-store.db"
#
# CHẠY TRÊN CLOUDFLARE PAGES: web dùng database D1 "fashion-store" qua
# binding DB trong wrangler.toml. Nạp bảng + dữ liệu mẫu vào D1 thật bằng
# file fashion-store-d1-insert.sql trong D1 console của Cloudflare.
# Tham khảo cũ (không dùng nữa): MySQL
# "mysql://USER:PASSWORD@HOST:PORT/DATABASE".
#
# THANH TOÁN ONLINE (xem README, mục "Payments"). Để trống là chạy chế độ
# giả lập — khách bấm thanh toán sẽ sang trang thử nghiệm, không trừ tiền thật.
# Dán key thật vào .env.local khi chạy local, hoặc vào Cloudflare Pages →
# Settings → Environment variables khi chạy live. KHÔNG đưa key thật lên git.
#
# PayOS (VND) — đăng ký sandbox tại https://payos.vn
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
#
# SePay (VND, VietQR) — đăng ký tại https://sepay.vn, lấy API key ở
# SePay Dashboard → Tài khoản → API. SEPAY_BANK_CODE là mã ngân hàng
# (vd Vietcombank = VCB, BIDV, Techcombank = TCB...), xem danh sách ở
# https://qr.sepay.vn (chọn ngân hàng, mã hiện trong link QR).
SEPAY_API_KEY=
SEPAY_BANK_CODE=
SEPAY_ACCOUNT_NUMBER=
SEPAY_ACCOUNT_NAME=
# Link gốc của web, dùng làm returnUrl cho các cổng (vd https://fashion-store-1h4.pages.dev)
NEXT_PUBLIC_SITE_URL=
#
# EMAIL GIAO DỊCH (v6, xem README, mục "Emails"). Dùng Resend
# (https://resend.com) qua HTTP API — không dùng SMTP. Để trống là web
# không gửi mail (đăng ký / đặt hàng vẫn chạy bình thường, chỉ log lại).
# Dán key vào .env.local khi chạy local, hoặc vào Cloudflare Pages →
# Settings → Environment variables khi chạy live. KHÔNG đưa key thật lên git.
#
# Resend API key — tạo ở https://resend.com/api-keys (cần tài khoản Resend)
RESEND_API_KEY=
# Địa chỉ người gửi, dạng "Tên hiển thị <email@domain-cua-ban>". Domain
# phải được xác minh trong Resend (Domains) thì mail mới tới được mọi
# hộp thư; chưa xác minh thì chỉ gửi được tới email chủ tài khoản Resend.
EMAIL_FROM=
# Email nhận thông báo đơn hàng / thanh toán của admin. Để trống thì web
# tự lấy email tài khoản admin trong CSDL (mặc định admin@store.local).
ADMIN_EMAIL=
#
# Bật chế độ giả lập cho toàn bộ cổng online (true/false). Khi bật, khách
# luôn sang trang thử nghiệm dù đã có key thật.
PAYMENTS_SIMULATION=false
